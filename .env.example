# Copy to .env and fill in. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
# Least-privilege app user, created by `node db/setup.js`
DB_USER=wall_app
# Host the app user may connect from (default localhost; use % when MySQL runs in a container, as in CI)
# DB_APP_USER_HOST=localhost
DB_PASSWORD=
DB_NAME=the_wall
PORT=3000
# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# NODE_ENV=production enables secure cookies, HSTS and trust proxy
# Optional rate-limit overrides (defaults shown). The test suites raise these.
# RATE_LIMIT_LOGIN=10      failed logins per IP + username per 15 min
# RATE_LIMIT_REGISTER=5    accounts created per IP per hour
# RATE_LIMIT_WRITE=30      posts/edits/deletes/comments per user per minute
# RATE_LIMIT_LIKE=120      likes/unlikes per user per minute
